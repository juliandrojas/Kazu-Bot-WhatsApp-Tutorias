# Servidor de este bot
PORT=3000

# Datos de tu instancia de Evolution API
EVOLUTION_API_URL=https://tu-servidor-evolution.com
EVOLUTION_API_KEY=reemplaza-por-tu-api-key
EVOLUTION_INSTANCE=nombre-de-tu-instancia
# Secreto largo aleatorio. Configura este mismo valor como encabezado
# x-webhook-secret en Evolution API para el webhook.
WEBHOOK_SECRET=reemplaza-por-un-secreto-largo-aleatorio

# Acceso al panel /admin (autenticación HTTP Basic).
ADMIN_USERNAME=administrador
ADMIN_PASSWORD=reemplaza-por-una-contrasena-larga

# Calendario opcional: OAuth con permiso Calendar y calendario destino. El refresh
# token mantiene la integración operativa; el access token solo sirve para pruebas.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Protege la ejecución diaria de copias (Vercel Cron usa este secreto).
CRON_SECRET=reemplaza-por-otro-secreto-largo

# Personaliza el servicio ofrecido
TUTOR_PRICE=COP 45.000 por hora
# Número (con indicativo, sin +) que recibe cada solicitud confirmada.
TUTOR_NOTIFY_NUMBER=573052334098
# Jornada de atención, hora de Colombia; el límite superior no se incluye.
TUTOR_START_HOUR=7
TUTOR_END_HOUR=21

# Estado persistente para Vercel mediante Supabase.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=reemplaza-por-tu-service-role-key
